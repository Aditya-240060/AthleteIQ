# AthleteIQ Configuration

# LLM Providers: "groq", "ollama", or "offline_sports_science"
DEFAULT_LLM_PROVIDER=offline_sports_science

# Groq Cloud API Settings (Get your free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Settings (https://ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings & Vector Store Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_DIR=./vectorstore
CHROMA_COLLECTION_NAME=athlete_iq_cricket

# RAG & Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=4
HYBRID_ALPHA=0.5
RERANKER_TOP_N=3
